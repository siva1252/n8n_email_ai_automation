# Google / Gmail (n8n OAuth — never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=

# AI providers (optional fallbacks; leave empty to skip)
# Only open-weight / zero-credit routes are used when keys are present.
MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-nemo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ollama (primary, no API key)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_FALLBACK_MODEL=phi3:latest

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django_backend
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=change-me
DJANGO_ADMIN_EMAIL=admin@localhost

# Internal service security (n8n <-> Django)
INTERNAL_API_KEY=change-me

# Services
FLASK_AI_URL=http://flask_ai:5000
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/deal-action
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum-key!!
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=change-me

# Database (SQLite locally; swap to Postgres later)
DATABASE_URL=sqlite:///db.sqlite3

# RAG
RAG_DATA_DIR=./rag_data
VECTOR_DB_DIR=./data/vector_store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# AI policy
AI_PRIMARY_TIMEOUT_SECONDS=60
AI_FALLBACK_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MIN_CONFIDENCE=0.80
NEGOTIATION_MAX_ROUNDS=3
NEGOTIATION_MIN_PRICE=4000
NEGOTIATION_TARGET_PRICE=5000
AI_MOCK=false
DEMO_MODE=true
CREATOR_NAME=Siva

# Optional Gmail label for spam (n8n applies if enabled)
GMAIL_SPAM_LABEL=AI_SPAM
